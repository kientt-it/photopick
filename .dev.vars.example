# Choose one authentication method and uncomment its variables.
#
# Public Google Drive folder ("Anyone with the link" can view):
# DRIVE_API_KEY="your-google-drive-api-key"
#
# Private Google Drive folder shared with a service account:
# GOOGLE_SERVICE_ACCOUNT_EMAIL="photo-pick@lathanh.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google sign-in (OAuth 2.0 Web application credentials).
# Add https://your-site.example/api/auth/google/callback to Authorized redirect URIs.
# GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"
# AUTH_SESSION_SECRET="generate-a-long-random-secret-at-least-32-bytes"
# Comma-separated email addresses allowed to administer PhotoPick.
# ADMIN_EMAILS="admin@example.com"
